{
  "control": {
    "height": {
      "sm": {
        "$type": "number",
        "$value": "{size.40}"
      },
      "md": {
        "$type": "number",
        "$value": "{size.48}"
      },
      "lg": {
        "$type": "number",
        "$value": "{size.56}"
      }
    }
  },
  "focus-ring": {
    "width": {
      "$type": "number",
      "$value": 2
    },
    "offset": {
      "$type": "number",
      "$value": 2,
      "$description": "Gap between a focused control and its focus ring. Code: outline-offset. No Figma property binds to it."
    }
  },
  "border-width": {
    "default": {
      "$type": "number",
      "$value": 1
    },
    "control": {
      "$type": "number",
      "$value": 1.5
    },
    "strong": {
      "$type": "number",
      "$value": 2
    }
  },
  "icon-size": {
    "md": {
      "$type": "number",
      "$value": "{size.24}"
    }
  }
}
