{
  "control": {
    "height": {
      "xsm": {
        "$type": "number",
        "$value": "{size.36}"
      },
      "sm": {
        "$type": "number",
        "$value": "{size.40}"
      },
      "md": {
        "$type": "number",
        "$value": "{size.48}"
      },
      "lg": {
        "$type": "number",
        "$value": "{size.56}"
      }
    }
  },
  "focus-ring": {
    "width": {
      "$type": "number",
      "$value": 2,
      "$description": "Thickness of the external focus indicator stroke."
    },
    "offset": {
      "$type": "number",
      "$value": 2,
      "$description": "Visual gap between the component edge and the external focus ring. Figma has no bindable outline-offset property, so this value is applied to ring geometry and maps to CSS outline-offset."
    },
    "radius": {
      "$type": "number",
      "$value": 14,
      "$description": "Radius of the external focus ring; component radius plus the 2px focus-ring offset."
    }
  },
  "border-width": {
    "default": {
      "$type": "number",
      "$value": 1
    },
    "control": {
      "$type": "number",
      "$value": 1.5
    },
    "strong": {
      "$type": "number",
      "$value": 2
    }
  },
  "icon-size": {
    "md": {
      "$type": "number",
      "$value": "{size.24}"
    },
    "sm": {
      "$type": "number",
      "$value": "{size.20}"
    },
    "xsm": {
      "$type": "number",
      "$value": "{size.16}"
    }
  }
}
